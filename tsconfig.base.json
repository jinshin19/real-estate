{
  "compilerOptions": {
    // General
    "target": "ES2022",
    "lib": ["ES2022"],

    // Type Safety
    "strict": true,
    "noImplicitReturns": true,
    "noImplicitOverride": true,
    "noUnusedLocals": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,

    // Interop
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,

    // Shared helpers
    "importHelpers": true
  }
}
